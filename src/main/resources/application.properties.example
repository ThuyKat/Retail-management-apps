spring.application.name=demo
spring.mvc.view.prefix=/WEB-INF/views/
#spring.resource.static-locations=classpath:/static/
spring.mvc.view.suffix=.jsp
spring.datasource.url=jdbc:mysql://localhost:3307/all_in_small
spring.datasource.username=YOUR_VALUE_HERE
spring.datasource.password=YOUR_VALUE_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update 
# --> Hibernate will automatically update db based on JPA entities. for example, create permissions table if it doesn't exist.
spring.jpa.show-sql=true
#--> optional, enable logging of the SQL statements generated by Hibernate
app.host=http://localhost:8080
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
management.endpoints.web.exposure.include=*

server.port=8080


google.client.id=YOUR_VALUE_HERE
google.client.secret=YOUR_VALUE_HERE
google.redirect.uri=http://localhost:8080/user/oauth2callback
#http://localhost:8888/Callback

paypal.client.id=YOUR_VALUE_HERE
paypal.client.secret=YOUR_VALUE_HERE

support.email=you@example.com
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/api-docs/swagger-ui.html
springdoc.swagger-ui.enabled=true

